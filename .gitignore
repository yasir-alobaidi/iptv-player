tools/media_samples/out/

# Spike outputs (spike code is tracked; results and builds are not)
spike/**/out/
spike/**/*.log
spike/**/results/

# Generated design bundle (rebuilt from design/*.dc.html and design/canvas.json)
design/iptv-player-ui.html

# Runtime leftovers
*.part
*.pid
logs/
.env
# Vendored plugin copies are rebuilt from the pub cache + the .patch next to them
spike/vendor/*/
